---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import FormattedDate from '@components/FormattedDate.astro'
import SiteLayout from './SiteLayout.astro'
import ImageLightbox from '@components/ImageLightbox.astro'
import ReadingTime from '@components/ReadingTime.astro'
import { categoryHref, tagHref, SITE_AUTHOR } from '@/consts'

type Props = CollectionEntry<'blog'>['data'] & { body?: string }
const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  heroImageAlt,
  category,
  tags,
  body,
} = Astro.props
const postURL = new URL(Astro.url.pathname, Astro.site).href
---

<SiteLayout
  {title}
  {description}
  image={heroImage}
  type="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={updatedDate?.toISOString()}
  schema={{
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    ...(updatedDate && { dateModified: updatedDate.toISOString() }),
    url: postURL,
    mainEntityOfPage: { '@type': 'WebPage', '@id': postURL },
    author: {
      '@type': 'Person',
      name: SITE_AUTHOR,
      url: new URL('/about', Astro.site).href,
    },
    ...(heroImage && { image: new URL(heroImage.src, Astro.site).href }),
  }}
>
  <ImageLightbox />

  {
    heroImage && (
      <div class="aspect-[3/2] w-full overflow-hidden sm:aspect-auto sm:max-h-[52vh] sm:min-h-[260px]">
        <Image
          width={2040}
          height={816}
          quality={85}
          src={heroImage}
          alt={heroImageAlt ?? title}
          class="h-full w-full object-cover"
        />
      </div>
    )
  }

  <div class="mx-auto w-full max-w-[74rem] px-6 py-16 md:px-10">
    <div class="grid grid-cols-1 gap-12 xl:grid-cols-[1fr_200px] xl:gap-16">
      <article
        class="mx-auto flex w-full max-w-2xl min-w-0 flex-col gap-8 xl:mx-0 xl:max-w-none"
      >
        <header class="flex flex-col gap-5">
          <div class="flex flex-col gap-3">
            {
              category && (
                <a
                  href={categoryHref(category)}
                  class="text-highlight w-fit text-xs font-medium tracking-wide no-underline hover:underline"
                >
                  {category}
                </a>
              )
            }
            <h1
              class="text-[clamp(1.65rem,1.2rem+1.8vw,2.35rem)] font-semibold tracking-[-0.03em]"
            >
              {title}
            </h1>
          </div>

          {
            description && (
              <p class="text-text-secondary border-l-2 border-(--highlight)/40 pl-4 text-sm leading-relaxed">
                {description}
              </p>
            )
          }

          <div
            class="text-text-tertiary flex flex-wrap items-center gap-3 text-sm"
          >
            <FormattedDate date={pubDate} />
            <span class="text-(--text-secondary)/30">·</span>
            <ReadingTime body={body ?? ''} />
            {
              updatedDate && (
                <>
                  <span class="text-(--text-secondary)/30">·</span>
                  <span>
                    Updated <FormattedDate date={updatedDate} />
                  </span>
                </>
              )
            }
          </div>
        </header>

        <div class="prose dark:prose-invert max-w-none">
          <slot />
        </div>

        <footer class="space-y-6">
          {
            tags && tags.length > 0 && (
              <div class="flex flex-wrap gap-x-4 gap-y-2">
                {tags.map((tag) => (
                  <a
                    rel="tag"
                    href={tagHref(tag)}
                    class="text-text-tertiary hover:text-highlight text-sm no-underline"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            )
          }
          <div class="border-border border-t pt-6">
            <a
              href="/blog/"
              class="text-highlight text-sm font-medium no-underline hover:underline"
            >
              ← All writing
            </a>
          </div>
        </footer>
      </article>

      <aside id="toc-sidebar" class="hidden w-[200px] shrink-0 xl:block">
        <div class="sticky top-24">
          <p
            class="text-text-tertiary mb-3 text-[11px] font-medium tracking-[0.14em] uppercase"
          >
            On this page
          </p>
          <nav id="toc-nav" class="flex flex-col gap-0.5"></nav>
        </div>
      </aside>
    </div>
  </div>
</SiteLayout>

<script>
  function initToC() {
    const nav = document.getElementById('toc-nav')
    const sidebar = document.getElementById('toc-sidebar')
    if (!nav || !sidebar) return

    nav.innerHTML = ''

    const headings = Array.from(
      document.querySelectorAll<HTMLHeadingElement>('article h2, article h3'),
    )

    if (headings.length < 2) {
      sidebar.style.display = 'none'
      return
    }

    sidebar.style.display = ''

    headings.forEach((heading) => {
      if (!heading.id) {
        heading.id = heading
          .textContent!.toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/(^-|-$)/g, '')
      }

      const link = document.createElement('a')
      link.href = '#' + heading.id
      link.textContent = heading.textContent
      link.className = 'toc-link' + (heading.tagName === 'H3' ? ' toc-h3' : '')
      link.dataset.heading = heading.id
      link.dataset.active = 'false'
      nav.appendChild(link)
    })

    const updateActive = () => {
      let activeId = headings[0]?.id ?? ''
      for (const h of headings) {
        if (h.getBoundingClientRect().top <= 120) activeId = h.id
      }
      nav.querySelectorAll<HTMLAnchorElement>('.toc-link').forEach((l) => {
        l.dataset.active = String(l.dataset.heading === activeId)
      })
    }

    window.addEventListener('scroll', updateActive, { passive: true })
    updateActive()
  }

  document.addEventListener('astro:page-load', initToC)
  initToC()
</script>
