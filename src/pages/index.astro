---
import SiteLayout from '@layouts/SiteLayout.astro'
import FormattedDate from '@components/FormattedDate.astro'
import Portrait from '@components/Portrait.astro'
import SectionIndex from '@components/SectionIndex.astro'
import WorkIndex from '@components/WorkIndex.astro'
import {
  CONTACT_EMAIL,
  CONTACT_MAILTO,
  externalRel,
  GITHUB_LINK,
  HOME_DESCRIPTION,
  HOME_TITLE,
  HOMEPAGE_SHIPPED_COUNT,
  LINKEDIN_LINK,
  SITE_AUTHOR,
} from '@/consts'
import { getCollection } from 'astro:content'

const latest = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
---

<SiteLayout title={HOME_TITLE} description={HOME_DESCRIPTION} exactTitle>
  <div class="page-container-wide">
    <header
      class="grid items-start gap-8 pt-12 pb-4 md:grid-cols-[minmax(0,1fr)_auto] md:gap-14 lg:pt-16"
    >
      <div class="order-2 max-w-[40rem] md:order-1">
        <h1
          id="hero-name"
          class="font-display text-hero-name text-text-primary leading-[1.02] font-[560] tracking-[-0.03em]"
        >
          {SITE_AUTHOR}
        </h1>
        <p class="text-text-primary mt-5 text-lg leading-snug">
          Full-stack & ML/AI builder
        </p>
        <p class="text-text-secondary mt-2 text-base leading-relaxed">
          Open to SWE · ML · full-stack
        </p>
        <p class="text-text-secondary mt-1 text-base leading-relaxed">
          Master’s in AI at Monash · Melbourne
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href={CONTACT_MAILTO} class="btn-primary">{CONTACT_EMAIL}</a>
          {
            GITHUB_LINK && (
              <a
                href={GITHUB_LINK.href}
                target="_blank"
                rel={externalRel(GITHUB_LINK)}
                class="quiet-link"
              >
                GitHub
              </a>
            )
          }
          {
            LINKEDIN_LINK && (
              <a
                href={LINKEDIN_LINK.href}
                target="_blank"
                rel={externalRel(LINKEDIN_LINK)}
                class="quiet-link"
              >
                LinkedIn
              </a>
            )
          }
        </div>
      </div>
      <Portrait
        priority
        class="order-1 w-36 sm:w-40 md:order-2 md:w-48 lg:w-52"
      />
    </header>

    <div class="flex flex-col gap-16 pt-12 pb-20 lg:gap-20 lg:pt-16 lg:pb-28">
      <section
        id="work"
        class="section-anchor flex flex-col gap-8"
        aria-labelledby="work-heading"
      >
        <SectionIndex
          index="01"
          label="Work"
          headingId="work-heading"
          href="/work/"
          linkLabel="All work"
        />
        <WorkIndex limit={HOMEPAGE_SHIPPED_COUNT} />
      </section>

      <section
        id="writing"
        class="section-anchor flex flex-col gap-6"
        aria-labelledby="writing-heading"
      >
        <SectionIndex
          index="02"
          label="Writing"
          headingId="writing-heading"
          href="/blog/"
          linkLabel="All writing"
        />
        <ul class="border-t border-(--border)">
          {
            latest.map((post) => (
              <li class="border-b border-(--border)">
                <a
                  href={`/blog/${post.id}/`}
                  class="group grid gap-1 py-4 no-underline sm:grid-cols-[minmax(0,1fr)_auto] sm:items-baseline sm:gap-x-8"
                >
                  <span class="text-text-primary group-hover:text-highlight text-base leading-snug">
                    {post.data.title}
                  </span>
                  <span class="text-text-tertiary shrink-0 sm:text-right">
                    <FormattedDate date={post.data.pubDate} />
                  </span>
                  <span class="text-text-secondary max-w-[68ch] text-[0.9375rem] leading-relaxed sm:col-span-2">
                    {post.data.description}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section
        id="about"
        class="section-anchor flex flex-col gap-6"
        aria-labelledby="about-heading"
      >
        <SectionIndex
          index="03"
          label="About"
          headingId="about-heading"
          href="/about/"
          linkLabel="Full about"
        />
        <div class="text-text-secondary max-w-[68ch] space-y-4 text-base leading-relaxed">
          <p>
            My name is Arian. I'm based in Melbourne, Australia, and I build
            things with code. I started out curious about how software works,
            and over time that curiosity turned into a deeper interest in
            programming, problem solving, and building systems that are
            actually useful.
          </p>
          <p>
            I work across software development and AI/ML. I enjoy building
            full-stack web applications, training and deploying machine
            learning models, and exploring where those two meet. I recently
            finished a Master’s in Artificial Intelligence at Monash, and I’m
            based in Melbourne. I’m open to roles where I can keep building on
            both the product and ML side.
          </p>
          <p>
            This site is where I write about what I'm learning, building, and
            thinking about.
          </p>
        </div>
        <ul class="flex max-w-[68ch] flex-col gap-1.5">
          <li class="meta">
            Monash · Master of Computer Science, Artificial Intelligence
          </li>
          <li class="meta">
            RMIT · Bachelor of Information Technology, Digital Design
          </li>
        </ul>
      </section>

      <section
        id="contact"
        class="section-anchor flex flex-col gap-5"
        aria-labelledby="contact-heading"
      >
        <SectionIndex index="04" label="Contact" headingId="contact-heading" />
        <p class="text-text-secondary max-w-[68ch] text-base leading-relaxed">
          Open to roles in SWE, ML, and full-stack. The best way to reach me
          is by email.
        </p>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          <a
            href={CONTACT_MAILTO}
            class="text-highlight text-base no-underline hover:underline"
          >
            {CONTACT_EMAIL}
          </a>
          {
            GITHUB_LINK && (
              <a
                href={GITHUB_LINK.href}
                target="_blank"
                rel={externalRel(GITHUB_LINK)}
                class="quiet-link"
              >
                GitHub
              </a>
            )
          }
          {
            LINKEDIN_LINK && (
              <a
                href={LINKEDIN_LINK.href}
                target="_blank"
                rel={externalRel(LINKEDIN_LINK)}
                class="quiet-link"
              >
                LinkedIn
              </a>
            )
          }
        </div>
      </section>
    </div>
  </div>
</SiteLayout>
