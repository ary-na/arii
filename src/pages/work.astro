---
import SiteLayout from '@layouts/SiteLayout.astro'
import WorkIndex from '@components/WorkIndex.astro'
import { WORK_DESCRIPTION } from '@/consts'
---

<SiteLayout title="Work" description={WORK_DESCRIPTION}>
  <section class="page-container-wide py-14 md:py-20">
    <p class="meta">Work</p>
    <h1 class="text-section mt-3 font-semibold tracking-[-0.03em]">
      Selected projects
    </h1>
    <p class="text-text-secondary mt-4 max-w-[62ch] leading-relaxed">
      Products and tools I’ve shipped, with write-ups, source, and demos when
      they exist. Older coursework and experiments live in{' '}
      <a href="/blog/" class="text-highlight underline-offset-2 hover:underline"
        >writing</a
      >.
    </p>

    <div class="mt-12">
      <WorkIndex />
    </div>
  </section>
</SiteLayout>
