---
import SiteLayout from '@layouts/SiteLayout.astro'
import { SITE_TITLE } from '@/consts'
---

<SiteLayout
  title={`404 — ${SITE_TITLE}`}
  description="This page doesn't exist."
>
  <section
    class="page-container flex flex-1 flex-col items-center justify-center gap-8 py-28 text-center"
  >
    <div class="flex flex-col gap-3">
      <p class="text-highlight text-sm font-medium">404</p>
      <h1 class="text-hero-name text-text-primary font-semibold">
        Page not found
      </h1>
      <p class="text-text-secondary">This page doesn't exist or was moved.</p>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a href="/" class="btn-primary">Home</a>
      <a href="/work/" class="btn-secondary">View work</a>
    </div>
  </section>
</SiteLayout>
