---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import ProjectLink from "./ProjectLink.astro";
import type { ShippedProject } from "@/consts";

interface Props {
  project: ShippedProject;
  index?: number;
  showImage?: boolean;
}

const { project, index = 0, showImage = false } = Astro.props;
const writeup = `/blog/${project.slug}/`;
const post = showImage ? await getEntry("blog", project.slug) : undefined;
const heroImage = post?.data.heroImage;
---

<article
  data-animate
  style={`--animate-delay: ${index * 60}ms`}
  class="project-card flex flex-col gap-5 rounded-xl border border-(--border) bg-(--bg-elevated) p-5 shadow-(--box-shadow) sm:flex-row sm:items-center sm:justify-between md:p-6"
>
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h3
        class="text-card-title text-text-primary font-semibold tracking-tight"
      >
        <a
          href={writeup}
          class="text-text-primary hover:text-highlight no-underline transition-colors duration-200"
        >
          {project.name}
        </a>
      </h3>
    </div>
    <p class="text-text-secondary mt-2 max-w-2xl text-sm leading-relaxed">
      {project.outcome}
    </p>
    {
      project.tech.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5">
          {project.tech.map((item) => (
            <li class="tech-chip">{item}</li>
          ))}
        </ul>
      )
    }
    <ProjectLink
      variant="card"
      writeup={writeup}
      github={project.github}
      demo={project.demo}
      npm={project.npm}
    />
  </div>
  {
    heroImage && (
      <a
        href={writeup}
        aria-hidden="true"
        tabindex="-1"
        class="block aspect-[4/3] w-full shrink-0 overflow-hidden rounded-lg border border-(--border) sm:w-40 md:w-48"
      >
        <Image
          src={heroImage}
          alt=""
          width={384}
          height={288}
          quality={80}
          class="h-full w-full object-cover"
        />
      </a>
    )
  }
</article>
