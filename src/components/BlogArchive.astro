---
import SiteLayout from '@layouts/SiteLayout.astro'
import type { CollectionEntry } from 'astro:content'
import FormattedDate from './FormattedDate.astro'
import PaginationNav from './PaginationNav.astro'

type Post = CollectionEntry<'blog'>

interface Props {
  archiveLabel: string
  archiveTitle: string
  countLabel: string
  countNumber?: number
  description: string
  canonicalPath?: string
  noindex?: boolean
  currentPage?: number
  hrefForPage?: (page: number) => string
  title: string
  totalPages?: number
  posts: Post[]
}

const {
  archiveLabel,
  archiveTitle,
  canonicalPath,
  noindex,
  countLabel,
  countNumber,
  currentPage = 1,
  description,
  hrefForPage,
  title,
  totalPages = 1,
  posts,
} = Astro.props

const isFiltered = !!archiveTitle
const gridPosts = posts
---

<SiteLayout
  {title}
  {description}
  {canonicalPath}
  noindex={noindex || currentPage > 1}
>
  <section class="page-container flex flex-col gap-8 py-16">
    <div class="flex flex-col gap-3">
      {
        isFiltered && (
          <a
            href="/blog/"
            class="text-text-secondary hover:text-highlight inline-flex w-fit items-center gap-1.5 text-sm no-underline transition-colors duration-200"
          >
            ← All writing
          </a>
        )
      }
      <div class="flex flex-col gap-2">
        <p class="meta">Writing</p>
        <h1 class="text-section font-semibold">
          {isFiltered ? archiveTitle : archiveLabel}
        </h1>
        <p class="text-text-tertiary text-sm">
          {countLabel}
          {countNumber !== undefined && ` · ${countNumber}`}
        </p>
      </div>
    </div>

    {
      gridPosts.length > 0 && (
        <ul class="border-t border-(--border)">
          {gridPosts.map((post, i) => (
            <li data-animate style={`--animate-delay: ${i * 40}ms`} class="border-b border-(--border)">
              <a
                href={`/blog/${post.id}/`}
                class="group grid gap-1 py-4 no-underline sm:grid-cols-[minmax(0,1fr)_auto] sm:items-baseline sm:gap-x-8"
              >
                <span class="text-text-primary group-hover:text-highlight text-base leading-snug">
                  {post.data.title}
                </span>
                <span class="text-text-tertiary flex shrink-0 items-baseline gap-4 sm:justify-end">
                  {post.data.category && (
                    <span class="meta hidden sm:inline">{post.data.category}</span>
                  )}
                  <FormattedDate date={post.data.pubDate} />
                </span>
                {post.data.description && (
                  <span class="text-text-secondary max-w-[68ch] text-[0.9375rem] leading-relaxed sm:col-span-2">
                    {post.data.description}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      hrefForPage && (
        <PaginationNav
          currentPage={currentPage}
          totalPages={totalPages}
          hrefForPage={hrefForPage}
        />
      )
    }
  </section>
</SiteLayout>
