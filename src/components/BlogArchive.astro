---
import SiteLayout from '@layouts/SiteLayout.astro'
import type { CollectionEntry } from 'astro:content'
import FormattedDate from './FormattedDate.astro'
import PaginationNav from './PaginationNav.astro'

type Post = CollectionEntry<'blog'>

interface Props {
  archiveLabel: string
  archiveTitle: string
  countLabel: string
  countNumber?: number
  description: string
  canonicalPath?: string
  noindex?: boolean
  currentPage?: number
  hrefForPage?: (page: number) => string
  title: string
  totalPages?: number
  posts: Post[]
}

const {
  archiveLabel,
  archiveTitle,
  canonicalPath,
  noindex,
  countLabel,
  countNumber,
  currentPage = 1,
  description,
  hrefForPage,
  title,
  totalPages = 1,
  posts,
} = Astro.props

const isFiltered = !!archiveTitle
const gridPosts = posts
---

<SiteLayout
  {title}
  {description}
  {canonicalPath}
  noindex={noindex || currentPage > 1}
>
  <section class="page-container flex flex-col gap-8 py-16">
    <div class="flex flex-col gap-3">
      {
        isFiltered && (
          <a
            href="/blog/"
            class="text-text-secondary hover:text-highlight inline-flex w-fit items-center gap-1.5 text-sm no-underline transition-colors duration-200"
          >
            ← All writing
          </a>
        )
      }
      <div class="flex flex-col gap-2">
        <p class="text-text-tertiary text-sm font-medium">Writing</p>
        <h1 class="text-section font-semibold">
          {isFiltered ? archiveTitle : archiveLabel}
        </h1>
        <p class="text-text-tertiary text-sm">
          {countLabel}
          {countNumber !== undefined && ` · ${countNumber}`}
        </p>
      </div>
    </div>

    {
      gridPosts.length > 0 && (
        <ul class="flex flex-col gap-3">
          {gridPosts.map((post, i) => (
            <li data-animate style={`--animate-delay: ${i * 50}ms`}>
              <a
                href={`/blog/${post.id}/`}
                class="project-card group flex flex-col gap-1 rounded-xl border border-(--border) bg-(--bg-elevated) px-5 py-4 no-underline sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
              >
                <span class="text-text-primary group-hover:text-highlight text-[0.95rem] font-medium transition-colors">
                  {post.data.title}
                </span>
                <span class="text-text-tertiary flex shrink-0 items-baseline gap-4 text-sm">
                  {post.data.category && (
                    <span class="hidden sm:inline">{post.data.category}</span>
                  )}
                  <FormattedDate date={post.data.pubDate} />
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      hrefForPage && (
        <PaginationNav
          currentPage={currentPage}
          totalPages={totalPages}
          hrefForPage={hrefForPage}
        />
      )
    }
  </section>
</SiteLayout>
