---
interface Props {
  currentPage: number;
  totalPages: number;
  hrefForPage: (page: number) => string;
}

const { currentPage, totalPages, hrefForPage } = Astro.props;

if (totalPages <= 1) {
  return null;
}

const progress = Math.round((currentPage / totalPages) * 100);
---

<nav aria-label="Pagination" class="mt-4 flex flex-col items-center gap-4">
  <div class="flex items-center gap-6">
    {
      currentPage > 1 ? (
        <a
          href={hrefForPage(currentPage - 1)}
          aria-label="Previous page"
          class="text-text-secondary hover:text-highlight text-sm no-underline transition-colors duration-200"
        >
          ← Prev
        </a>
      ) : (
        <span class="text-text-secondary/25 text-sm select-none">← Prev</span>
      )
    }

    <span class="text-text-tertiary text-sm tabular-nums">
      <span class="text-highlight font-medium">{currentPage}</span>
      <span class="mx-1 opacity-40">/</span>
      {totalPages}
    </span>

    {
      currentPage < totalPages ? (
        <a
          href={hrefForPage(currentPage + 1)}
          aria-label="Next page"
          class="text-text-secondary hover:text-highlight text-sm no-underline transition-colors duration-200"
        >
          Next →
        </a>
      ) : (
        <span class="text-text-secondary/25 text-sm select-none">Next →</span>
      )
    }
  </div>

  <div class="h-px w-32 overflow-hidden rounded-full bg-(--text-secondary)/10">
    <div
      class="bg-highlight/60 h-full rounded-full transition-all duration-500"
      style={`width: ${progress}%`}
    >
    </div>
  </div>
</nav>
