---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  href="/"
  class:list={[
    "font-display inline-flex items-baseline text-[1.125rem] font-[560] tracking-[-0.03em] no-underline",
    className,
  ]}
>
  <span class="text-text-primary">arii</span>
  <span class="text-highlight">.dev</span>
</a>
