---
import { PRIMARY_NAV, isNavActive } from "@/consts";
import Wordmark from "./Wordmark.astro";
import ThemeToggle from "./ThemeToggle.astro";

const pathname = Astro.url.pathname;
---

<header class="fixed top-0 right-0 left-0 z-50">
  <div
    class="border-b border-(--border) bg-(--bg-primary)/85 shadow-(--box-shadow) backdrop-blur-md"
  >
    <div
      class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-6 md:px-10 lg:px-16"
    >
      <Wordmark />

      <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
        {
          PRIMARY_NAV.map((item) => {
            const active = isNavActive(pathname, item.href);
            return (
              <a
                href={item.href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "rounded-md px-3 py-1.5 text-sm font-medium no-underline transition-colors duration-200",
                  active
                    ? "text-highlight"
                    : "text-text-secondary hover:text-text-primary",
                ]}
              >
                {item.label}
              </a>
            );
          })
        }
        <ThemeToggle class="ml-2" />
      </nav>

      <div class="flex items-center gap-2 md:hidden">
        <ThemeToggle />
        <button
          id="mobile-toggle"
          aria-label="Toggle menu"
          aria-expanded="false"
          class="text-text-primary relative flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg border border-(--border) bg-(--bg-elevated) transition"
        >
          <span
            class="mobile-line mobile-line--top absolute block h-0.5 w-4 rounded-full bg-current transition-all duration-300 ease-out"
          ></span>
          <span
            class="mobile-line mobile-line--middle absolute block h-0.5 w-4 rounded-full bg-current transition-all duration-200 ease-out"
          ></span>
          <span
            class="mobile-line mobile-line--bottom absolute block h-0.5 w-4 rounded-full bg-current transition-all duration-300 ease-out"
          ></span>
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="bg-surface-primary border-b border-(--border) md:hidden"
  >
    <div class="flex flex-col gap-1 px-6 py-3">
      {
        PRIMARY_NAV.map((item) => {
          const active = isNavActive(pathname, item.href);
          return (
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "rounded-lg px-3 py-2.5 text-sm font-medium no-underline transition-all duration-200",
                active
                  ? "text-highlight bg-(--highlight)/10"
                  : "text-text-secondary hover:text-text-primary hover:bg-(--bg-secondary)",
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </div>
  </div>
</header>

<style>
  .mobile-line {
    left: 50%;
    top: 50%;
    transform-origin: center;
    translate: -50% -50%;
  }

  .mobile-line--top {
    transform: translateY(-5px);
  }
  .mobile-line--middle {
    transform: translateY(0);
  }
  .mobile-line--bottom {
    transform: translateY(5px);
  }

  #mobile-menu {
    overflow: hidden;
    max-height: 0;
    transition: max-height 300ms ease;
  }

  #mobile-menu.is-open {
    max-height: var(--menu-height, 600px);
  }

  #mobile-toggle.is-open .mobile-line--top {
    transform: rotate(45deg);
  }
  #mobile-toggle.is-open .mobile-line--middle {
    transform: scaleX(0);
    opacity: 0;
  }
  #mobile-toggle.is-open .mobile-line--bottom {
    transform: rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-menu,
    .mobile-line {
      transition: none;
    }
  }
</style>

<script>
  const initHeader = () => {
    const toggle = document.getElementById(
      "mobile-toggle",
    ) as HTMLButtonElement | null;
    const menu = document.getElementById("mobile-menu") as HTMLElement | null;

    if (!toggle || !menu || toggle.dataset.bound === "true") return;
    toggle.dataset.bound = "true";

    toggle.addEventListener("click", () => {
      const open = menu.classList.toggle("is-open");
      toggle.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      menu.style.setProperty("--menu-height", menu.scrollHeight + "px");
    });
  };

  document.addEventListener("astro:page-load", initHeader);
  initHeader();
</script>
