---
interface Props {
  demo?: string;
  github?: string;
  githubBackend?: string;
  npm?: string;
  trello?: string;
  email?: string;
  writeup?: string;
  demoCrossed?: boolean;
  demoLabel?: string;
  githubLabel?: string;
  githubBackendLabel?: string;
  npmLabel?: string;
  trelloLabel?: string;
  emailLabel?: string;
  writeupLabel?: string;
  variant?: "inline" | "card";
}

const {
  demo,
  github,
  githubBackend,
  npm,
  trello,
  email,
  writeup,
  demoCrossed,
  demoLabel = "Live demo",
  githubLabel = "GitHub",
  githubBackendLabel = "GitHub backend",
  npmLabel = "npm",
  trelloLabel = "Trello",
  emailLabel = "Email",
  writeupLabel = "Write-up",
  variant = "inline",
} = Astro.props;

const isCard = variant === "card";
const wrapClass = isCard
  ? "mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm"
  : "my-4 flex flex-wrap gap-x-4 gap-y-2 text-sm";

type Item = {
  href: string;
  label: string;
  external?: boolean;
  crossed?: boolean;
  mailto?: boolean;
};

const items: Item[] = [];
if (writeup) items.push({ href: writeup, label: writeupLabel });
if (demo)
  items.push({
    href: demo,
    label: demoLabel,
    external: true,
    crossed: demoCrossed,
  });
if (github) items.push({ href: github, label: githubLabel, external: true });
if (githubBackend)
  items.push({
    href: githubBackend,
    label: githubBackendLabel,
    external: true,
  });
if (npm) items.push({ href: npm, label: npmLabel, external: true });
if (trello) items.push({ href: trello, label: trelloLabel, external: true });
if (email)
  items.push({
    href: `mailto:${email}`,
    label: emailLabel,
    mailto: true,
  });
---

{
  items.length > 0 && (
    <div class={wrapClass}>
      {items.map((item) => (
        <a
          href={item.href}
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noopener noreferrer" : undefined}
          class="group text-highlight hover:text-text-primary inline-flex items-center gap-1 font-medium no-underline transition-colors duration-200"
        >
          <span class:list={[{ "line-through opacity-70": item.crossed }]}>
            {item.label}
          </span>
          {item.external && (
            <span aria-hidden="true" class="text-xs opacity-70">
              ↗
            </span>
          )}
          {!item.external && !item.mailto && (
            <span aria-hidden="true" class="text-xs opacity-70">
              →
            </span>
          )}
        </a>
      ))}
    </div>
  )
}
