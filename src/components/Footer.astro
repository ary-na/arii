---
import {
  CONTACT_EMAIL,
  CONTACT_MAILTO,
  externalRel,
  PRIMARY_NAV,
  SITE_AUTHOR,
  SOCIAL_LINKS,
} from "@/consts";
import Wordmark from "./Wordmark.astro";

const today = new Date();
---

<footer class="relative z-10 mt-auto pt-10">
  <div class="bg-surface-primary overflow-hidden border-t border-(--border)">
    <div class="relative">
      <div class="page-container-wide relative z-10 py-16">
        <div class="flex flex-col gap-10 sm:flex-row sm:justify-between">
          <div class="flex max-w-xs flex-col gap-3">
            <Wordmark />
            <p class="text-text-secondary text-[0.9375rem] leading-relaxed">
              Full-stack and ML/AI builder in Melbourne. Open to roles in SWE,
              ML, and full-stack.
            </p>
            <a
              href={CONTACT_MAILTO}
              class="text-highlight text-sm font-medium no-underline hover:underline"
            >
              {CONTACT_EMAIL}
            </a>
          </div>

          <div class="flex gap-16">
            <div class="flex flex-col gap-2.5">
              <span
                class="text-text-tertiary text-[11px] font-medium tracking-[0.14em] uppercase"
                >Nav</span
              >
              {
                PRIMARY_NAV.map((item) => (
                  <a
                    href={item.href}
                    class="text-text-secondary hover:text-highlight text-sm no-underline transition-colors duration-200"
                  >
                    {item.label}
                  </a>
                ))
              }
            </div>

            <div class="flex flex-col gap-2.5">
              <span
                class="text-text-tertiary text-[11px] font-medium tracking-[0.14em] uppercase"
                >Connect</span
              >
              {
                SOCIAL_LINKS.filter(
                  (link) => !link.href.startsWith("mailto:"),
                ).map((link) => (
                  <a
                    href={link.href}
                    target="_blank"
                    rel={externalRel(link)}
                    class="text-text-secondary hover:text-highlight text-sm no-underline transition-colors duration-200"
                  >
                    {link.label}
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <div
          class="mt-10 flex flex-col gap-1 border-t border-(--border) pt-6 sm:flex-row sm:items-center sm:justify-between"
        >
          <p class="text-text-tertiary text-xs">
            &copy; {today.getFullYear() + " "}
            {SITE_AUTHOR}. All rights reserved.
          </p>
          <p class="text-text-tertiary text-xs">Built with Astro</p>
        </div>
      </div>
    </div>
  </div>
</footer>
