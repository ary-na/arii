---
interface Props {
  class?: string
  priority?: boolean
}

const { class: className, priority = false } = Astro.props
---

<figure class:list={['portrait', className]}>
  <img
    src="/blog/about/arian.webp"
    alt="Arian Najafi Yamchelo"
    width="800"
    height="1000"
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
  />
</figure>
